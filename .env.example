# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this application is hosted.
APP_URL="MY_APP_URL"

# Database Configuration (Supabase)
VITE_SUPABASE_URL="MY_SUPABASE_URL"
VITE_SUPABASE_ANON_KEY="MY_SUPABASE_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="MY_SUPABASE_SERVICE_ROLE_KEY"

# Server Info
VITE_SERVER_INTERNAL_IP=""
VITE_SERVER_EXTERNAL_IP=""

# White Label & Agency Config
VITE_COMPANY_NAME="Minha Agência CRM"
VITE_PRIMARY_COLOR="#4f46e5"

# WhatsApp Integration (Optional)
VITE_WHATSAPP_PHONE_ID=""
VITE_WHATSAPP_BUSINESS_ID=""
WHATSAPP_ACCESS_TOKEN=""

# Google Drive OAuth
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_REDIRECT_URI="https://your-app-url.run.app/api/google/callback"

# Facebook OAuth
FACEBOOK_APP_ID="your_facebook_app_id"
FACEBOOK_APP_SECRET="your_facebook_app_secret"
FACEBOOK_REDIRECT_URI="https://your-app-url.run.app/api/facebook/callback"

# Security
DB_ENCRYPTION_KEY="your_secret_encryption_key_here"
JWT_SECRET="your_jwt_secret_here"

# Gemini AI (Optional)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

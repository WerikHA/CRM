# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Database Configuration
DB_HOST=db
DB_PORT=5432
DB_USER=agency_admin
DB_PASSWORD=agency_secure_password
DB_NAME=agencyflow_db
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# White Label & Agency Config
VITE_COMPANY_NAME="Minha Agência CRM"
VITE_PRIMARY_COLOR="#4f46e5"

# WhatsApp Integration (Optional)
VITE_WHATSAPP_PHONE_ID=""
VITE_WHATSAPP_BUSINESS_ID=""
WHATSAPP_ACCESS_TOKEN=""

# Gemini AI (Optional)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

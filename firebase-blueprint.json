{
  "entities": {
    "User": {
      "title": "User",
      "description": "System user (Admin, Designer, Editor, Partner)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["ADMIN", "DESIGNER", "PARTNER", "EDITOR", "OWNER"] },
        "avatar": { "type": "string" },
        "owner_id": { "type": "string", "format": "uuid" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "email", "role"]
    },
    "Client": {
      "title": "Client",
      "description": "Agency client",
      "type": "object",
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "name": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "paused", "former"] },
        "monthly_value": { "type": "number" },
        "renewal_date": { "type": "string" },
        "contact_email": { "type": "string" },
        "phone": { "type": "string" },
        "assigned_designer_id": { "type": "string", "format": "uuid" },
        "assigned_video_editor_id": { "type": "string", "format": "uuid" },
        "partner_id": { "type": "string", "format": "uuid" },
        "owner_id": { "type": "string", "format": "uuid" }
      },
      "required": ["id", "name", "status"]
    },
    "Lead": {
      "title": "Lead",
      "description": "Potential client",
      "type": "object",
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "company": { "type": "string" },
        "contact_name": { "type": "string" },
        "email": { "type": "string" },
        "status": { "type": "string" },
        "owner_id": { "type": "string", "format": "uuid" }
      },
      "required": ["id", "company", "contact_name"]
    },
    "ArtOrder": {
      "title": "Art Order",
      "description": "Design job",
      "type": "object",
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "title": { "type": "string" },
        "client_id": { "type": "string", "format": "uuid" },
        "designer_id": { "type": "string", "format": "uuid" },
        "status": { "type": "string" },
        "approval_status": { "type": "string" }
      },
      "required": ["id", "title", "client_id"]
    }
  },
  "firestore": {
    "users": { "schema": "User", "description": "Users table" },
    "clients": { "schema": "Client", "description": "Clients table" },
    "leads": { "schema": "Lead", "description": "Leads table" },
    "art_orders": { "schema": "ArtOrder", "description": "Design orders" }
  }
}
